#!/bin/bash
# create-release.test.mjs 用的假 gh：記下每次呼叫，回傳跟 GitHub API 同形狀的 JSON，--jq 交給真的 jq 處理。
# 行為由 FAKE_* 環境變數決定（見測試檔）。
echo "$*" >> "$FAKE_LOG"
case "$1 $2" in
  "release view")
    [ -n "${FAKE_RELEASE_EXISTS:-}" ] && exit 0
    exit 1 ;;
  "release create")
    shift 2
    while [ $# -gt 0 ]; do
      if [ "$1" = --notes ]; then printf '%s' "$2" > "$FAKE_NOTES_OUT"; fi
      shift
    done
    if [ -n "${FAKE_CREATE_FAIL:-}" ]; then echo "HTTP 422: Validation Failed" >&2; exit 1; fi
    exit 0 ;;
esac
if [ "$1" != api ]; then
  echo "unexpected gh call: $*" >&2
  exit 9
fi
path="$2"
shift 2
jqexpr=""
while [ $# -gt 0 ]; do
  case "$1" in
    --jq) jqexpr="$2"; shift 2 ;;
    *) shift ;;
  esac
done
case "$path" in
  */git/ref/tags/*)
    if [ -n "${FAKE_TAG_MISSING:-}" ]; then echo "HTTP 404: Not Found" >&2; exit 1; fi
    json="$(jq -n --arg ref "refs/tags/${path##*/}" --arg type "${FAKE_TAG_TYPE:-tag}" '{ref: $ref, object: {type: $type, sha: "abc123"}}')" ;;
  */git/tags/abc123)
    json="$(jq -n --arg m "$FAKE_MESSAGE" '{tag: "x", message: $m}')" ;;
  */git/matching-refs/tags/v)
    if [ -n "${FAKE_REFS_FAIL:-}" ]; then echo "HTTP 502: Bad Gateway" >&2; exit 1; fi
    json="$(printf '%s\n' $FAKE_TAGS | jq -R '{ref: ("refs/tags/" + .)}' | jq -s .)" ;;
  *)
    echo "unexpected api call: $path" >&2
    exit 9 ;;
esac
if [ -n "$jqexpr" ]; then
  printf '%s' "$json" | jq -r "$jqexpr"
else
  printf '%s\n' "$json"
fi
